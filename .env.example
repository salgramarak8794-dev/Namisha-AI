# Namisha 2.0 Environment Configuration Example
# Copy to .env and configure as needed.

# Local Ollama Endpoint (Default: http://localhost:11434)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Google Gemini Integration (leave empty for 100% offline local mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice Engine Settings
EDGE_TTS_VOICE=en-US-AnaNeural
SPEAKING_SPEED=1.0

# Security & LAN
NAMISHA_PORT=8765
LAN_ENABLED=false
LAN_AUTH_PIN=
